# Only takes effect on Apache hosting (typical for cPanel/shared hosting).
# Harmless if the host runs something else (Nginx, static-only, etc.) —
# those platforms simply ignore this file; the redirect/header would need
# to be configured in their own dashboard/config instead.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force https://www.grapcadd.in (fixes the "duplicate content: www vs
  # non-www" + "canonical points to a different domain" issues flagged
  # by the SEO audit)
  RewriteCond %{HTTP_HOST} ^grapcadd\.in$ [NC]
  RewriteRule ^(.*)$ https://www.grapcadd.in/$1 [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.grapcadd.in/$1 [R=301,L]
</IfModule>

# Send charset in the HTTP header (the audit flagged it as missing there,
# even though the HTML <meta charset> tag was already correct)
<IfModule mod_headers.c>
  AddDefaultCharset UTF-8
</IfModule>

# Cache lifetimes for static assets (fixes the PageSpeed "Use efficient
# cache lifetimes" audit — images/css/js/fonts were serving with no
# Cache-Control at all, so repeat visits re-downloaded everything).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>
